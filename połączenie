stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/\u003e\u003cpath d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/\u003e\u003c/svg\u003eBez konta i bez spiny\u003c/div\u003e\n\u003c/header\u003e\n\u003cmain class=\"shell\"\u003e\u003cdiv class=\"layout\"\u003e\n  \u003csection class=\"intro\" aria-labelledby=\"page-title\"\u003e\u003cdiv class=\"eyebrow\"\u003e\u003cspan aria-hidden=\"true\"\u003e\u003c/span\u003eMa\u0142y krok, dobry kierunek\u003c/div\u003e\u003ch1 id=\"page-title\"\u003eJedz tak, \u003cem\u003ejak chcia\u0142by\u015b si\u0119 czu\u0107.\u003c/em\u003e\u003c/h1\u003e\u003cdiv class=\"promise\"\u003e\u003cspan class=\"promise-icon\" aria-hidden=\"true\"\u003e\u003csvg viewBox=\"0 0 24 24\" fill=\"none\"\u003e\u003cpath d=\"M12 20s-7-4.1-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.9-7 10-7 10Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/\u003e\u003cpath d=\"M12 7c-.8-2.2.1-3.8 2-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/\u003e\u003c/svg\u003e\u003c/span\u003e\u003cspan\u003e\u003cstrong\u003eBez presji.\u003c/strong\u003e Wybierasz cele, reszta to Twoje tempo.\u003c/span\u003e\u003c/div\u003e\u003c/section\u003e\n  \u003csection class=\"form-card\" aria-labelledby=\"form-title\"\u003e\n    \u003cdiv class=\"form-heading\"\u003e\u003ch2 id=\"form-title\"\u003eZacznijmy od Twojego celu\u003c/h2\u003e\u003cp\u003eZaznacz maksymalnie 3 cele, kt\u00f3re s\u0105 dla Ciebie wa\u017cne.\u003c/p\u003e\u003c/div\u003e\n    \u003cform id=\"goal-form\" novalidate\u003e\n      \u003cdiv class=\"measurements\"\u003e\n        \u003cdiv\u003e\u003clabel class=\"field-label\" for=\"weight\"\u003eWaga\u003c/label\u003e\u003cdiv class=\"input-with-unit\"\u003e\u003cinput id=\"weight\" name=\"weight\" type=\"number\" inputmode=\"decimal\" min=\"20\" max=\"350\" step=\"0.1\" placeholder=\"Np. 68\" required aria-describedby=\"weight-unit\"/\u003e\u003cspan class=\"unit\" id=\"weight-unit\"\u003ekg\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n        \u003cdiv\u003e\u003clabel class=\"field-label\" for=\"height\"\u003eWzrost\u003c/label\u003e\u003cdiv class=\"input-with-unit\"\u003e\u003cinput id=\"height\" name=\"height\" type=\"number\" inputmode=\"numeric\" min=\"100\" max=\"250\" step=\"1\" placeholder=\"Np. 172\" required aria-describedby=\"height-unit\"/\u003e\u003cspan class=\"unit\" id=\"height-unit\"\u003ecm\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n      \u003c/div\u003e\n      \u003cp class=\"optional-note\"\u003eWaga i wzrost s\u0105 wymagane.\u003c/p\u003e\n      \u003cfieldset\u003e\u003clegend\u003eMoje cele\u003c/legend\u003e\u003cdiv class=\"goal-list\"\u003e\u003cdiv class=\"goal-option\"\u003e\u003cinput id=\"goal-lose\" name=\"goal\" type=\"checkbox\" value=\"schudn\u0105\u0107\"/\u003e\u003clabel for=\"goal-lose\"\u003e\u003cspan class=\"goal-icon\" aria-hidden=\"true\"\u003e\ud83c\udf3f\u003c/span\u003e\u003cspan class=\"goal-text\"\u003eSchudn\u0105\u0107\u003c/span\u003e\u003cspan class=\"radio-indicator\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/label\u003e\u003c/div\u003e\n\u003cdiv class=\"goal-option\"\u003e\u003cinput id=\"goal-gain\" name=\"goal\" type=\"checkbox\" value=\"przyty\u0107\"/\u003e\u003clabel for=\"goal-gain\"\u003e\u003cspan class=\"goal-icon\" aria-hidden=\"true\"\u003e\ud83c\udf31\u003c/span\u003e\u003cspan class=\"goal-text\"\u003ePrzyty\u0107\u003c/span\u003e\u003cspan class=\"radio-indicator\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/label\u003e\u003c/div\u003e\n\u003cdiv class=\"goal-option\"\u003e\u003cinput id=\"goal-product\" name=\"goal\" type=\"checkbox\" value=\"je\u015b\u0107 wi\u0119cej wybranych produkt\u00f3w\"/\u003e\u003clabel for=\"goal-product\"\u003e\u003cspan class=\"goal-icon\" aria-hidden=\"true\"\u003e\ud83e\udd51\u003c/span\u003e\u003cspan class=\"goal-text\"\u003eJe\u015b\u0107 wi\u0119cej wybranych produkt\u00f3w\u003c/span\u003e\u003cspan class=\"radio-indicator\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/label\u003e\u003c/div\u003e\n\u003cdiv class=\"goal-option\"\u003e\u003cinput id=\"goal-healthy\" name=\"goal\" type=\"checkbox\" value=\"je\u015b\u0107 zdrowiej\"/\u003e\u003clabel for=\"goal-healthy\"\u003e\u003cspan class=\"goal-icon\" aria-hidden=\"true\"\u003e\u2728\u003c/span\u003e\u003cspan class=\"goal-text\"\u003eJe\u015b\u0107 zdrowiej\u003c/span\u003e\u003cspan class=\"radio-indicator\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/label\u003e\u003c/div\u003e\n\u003cdiv class=\"goal-option\"\u003e\u003cinput id=\"goal-regular\" name=\"goal\" type=\"checkbox\" value=\"je\u015b\u0107 regularniej\"/\u003e\u003clabel for=\"goal-regular\"\u003e\u003cspan class=\"goal-icon\" aria-hidden=\"true\"\u003e\ud83d\udd52\u003c/span\u003e\u003cspan class=\"goal-text\"\u003eJe\u015b\u0107 regularniej\u003c/span\u003e\u003cspan class=\"radio-indicator\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/label\u003e\u003c/div\u003e\u003c/div\u003e\u003c/fieldset\u003e\n      \u003cdiv class=\"product-field\" id=\"product-field\" aria-hidden=\"true\"\u003e\u003cdiv class=\"product-inner\"\u003e\u003clabel for=\"favorite-product\"\u003eJakie produkty chcesz je\u015b\u0107 cz\u0119\u015bciej? (oddziel przecinkami)\u003c/label\u003e\u003cinput id=\"favorite-product\" name=\"product\" type=\"text\" placeholder=\"Np. warzywa, ryby, str\u0105czki\" autocomplete=\"off\" tabindex=\"-1\" aria-describedby=\"product-note\" disabled/\u003e\u003cp class=\"optional-note\" id=\"product-note\"\u003eWpisz co najmniej jeden produkt; mo\u017cesz poda\u0107 kilka, oddzielaj\u0105c je przecinkami.\u003c/p\u003e\u003c/div\u003e\u003c/div\u003e\n      \u003cbutton class=\"submit-button\" type=\"submit\"\u003eDopasuj m\u00f3j plan\u003csvg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"\u003e\u003cpath d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \u003cp class=\"privacy-note\"\u003e\u003csvg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"\u003e\u003crect x=\"5\" y=\"10\" width=\"14\" height=\"11\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.7\"/\u003e\u003cpath d=\"M8 10V7a4 4 0 1 1 8 0v3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/\u003e\u003c/svg\u003eDane z formularza nie s\u0105 zapisywane ani wysy\u0142ane.\u003c/p\u003e\n      \u003cp class=\"feedback\" id=\"feedback\" role=\"status\" aria-live=\"polite\"\u003e\u003c/p\u003e\n    \u003c/form\u003e\n  \u003c/section\u003e\n\u003c/div\u003e\u003cp class=\"footer-note\"\u003eDobre nawyki zaczynaj\u0105 si\u0119 od ma\u0142ych zmian.\u003c/p\u003e\u003c/main\u003e\n\n\u003cscript\u003e\n\"use strict\";\nconst form = document.getElementById(\"goal-form\");\nconst productField = document.getElementById(\"product-field\");\nconst productInput = document.getElementById(\"favorite-product\");\nconst feedback = document.getElementById(\"feedback\");\nconst maxGoals = 3;\nfunction clearFeedback() { feedback.textContent = \"\"; feedback.classList.remove(\"error\"); }\nfunction selected() { return Array.from(form.querySelectorAll('input[name=\"goal\"]:checked')); }\nfunction updateProductField() {\n  const showProduct = selected().some(goal =\u003e goal.id === \"goal-product\");\n  productField.classList.toggle(\"is-visible\", showProduct);\n  productField.setAttribute(\"aria-hidden\", String(!showProduct));\n  productInput.tabIndex = showProduct ? 0 : -1;\n  productInput.required = showProduct;\n  productInput.disabled = !showProduct;\n  if (!showProduct) productInput.value = \"\";\n  clearFeedback();\n}\nform.addEventListener(\"change\", event =\u003e {\n  if (event.target.name === \"goal\") {\n    if (event.target.checked \u0026\u0026 selected().length \u003e maxGoals) {\n      event.target.checked = false; updateProductField();\n      feedback.textContent = \"Mo\u017cesz zaznaczy\u0107 maksymalnie 3 cele.\";\n      feedback.classList.add(\"error\"); return;\n    }\n    updateProductField();\n  }\n});\nform.addEventListener(\"input\", clearFeedback);\nform.addEventListener(\"submit\", event =\u003e {\n  event.preventDefault(); clearFeedback();\n  const selectedGoals = selected();\n  if (selectedGoals.length \u003e maxGoals) {\n    feedback.textContent = \"Mo\u017cesz zaznaczy\u0107 maksymalnie 3 cele.\";\n    feedback.classList.add(\"error\"); return;\n  }\n  if (selectedGoals.length === 0) {\n    feedback.textContent = \"Wybierz przynajmniej jeden cel, aby przej\u015b\u0107 dalej.\";\n    feedback.classList.add(\"error\"); form.querySelector('input[name=\"goal\"]').focus(); return;\n  }\n  const products = productInput.value.split(\",\").map(product =\u003e product.trim()).filter(Boolean);\n  if (selectedGoals.some(goal =\u003e goal.id === \"goal-product\") \u0026\u0026 products.length === 0) {\n    feedback.textContent = \"Wpisz co najmniej jeden produkt. Kilka produkt\u00f3w oddziel przecinkami.\";\n    feedback.classList.add(\"error\"); productInput.focus(); return;\n  }\n  if (!form.reportValidity()) return;\n  const goals = selectedGoals.map(goal =\u003e goal.value);\n  const productGoalIndex = goals.indexOf(\"je\u015b\u0107 wi\u0119cej wybranych produkt\u00f3w\");\n  if (productGoalIndex !== -1) goals[productGoalIndex] += `: ${products.join(\", \")}`;\n  feedback.textContent = `Twoje cele to: ${goals.join(\", \")}. To podgl\u0105d wybor\u00f3w \u2014 generowanie planu i kolejny ekran s\u0105 jeszcze w przygotowaniu.`;\n});\nwindow.addEventListener(\"pageshow\", updateProductField);\nupdateProductField();\n\u003c/script\u003e\n\u003cscript\u003e\ndocument.addEventListener('click', function(event) {\n  const link = event.target.closest('a[data-screen]');\n  if (!link) return;\n  event.preventDefault();\n  window.parent.postMessage({app: 'TasteShift-single-file', screen: link.dataset.screen}, '*');\n});\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n"};
const frame = document.getElementById('app-screen');
let currentScreen = '';
function render() {
  const screen = window.location.hash === '#cele' ? 'goals' : 'welcome';
  if (screen === currentScreen) return;
  currentScreen = screen;
  const title = screen === 'goals' ? 'TasteShift — Twój cel żywieniowy' : 'TasteShift — ekran powitalny';
  frame.title = title;
  document.title = title;
  document.querySelector('meta[name="theme-color"]').content = screen === 'goals' ? '#e8eee1' : '#244f38';
  frame.srcdoc = screens[screen];
}
window.addEventListener('message', function(event) {
