<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TasteShift</title>
    <style>
      :root {
        --dark-green: #2c554b;
        --green-deep: #37665a;
        --green-soft: #4a786b;
        --beige: #f3e7d9;
        --beige-strong: #e5d3b5;
        --white: #ffffff;
        --text-soft: #dde9e6;
        --shadow: rgba(12, 28, 23, 0.22);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        min-height: 100%;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: #ffffff;
        color: var(--white);
      }

      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 28px;
      }

      .page {
        width: min(1220px, 100%);
        min-height: 760px;
        background: #244f38;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 34px;
        box-shadow: 0 28px 60px rgba(0,0,0,0.18);
        backdrop-filter: blur(4px);
        padding: 28px 38px 42px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        z-index: 4;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.8rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: var(--beige);
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border: 1px solid rgba(36, 79, 56, 0.22);
        border-radius: 13px;
        background: #ffffff;
      }

      .brand-mark svg {
        width: 25px;
        height: 25px;
        fill: none;
        stroke: #244f38;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .brand span {
        color: var(--white);
      }

      .settings-wrap {
        position: relative;
      }

      .dots-button {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.14);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .dots-button:hover {
        transform: translateY(-1px);
        background: rgba(255,255,255,0.12);
      }

      .dots-button span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--beige);
        display: block;
      }

      .panel {
        position: absolute;
        top: 60px;
        right: 0;
        width: 260px;
        background: rgba(255,255,255,0.94);
        color: var(--dark-green);
        border-radius: 20px;
        box-shadow: 0 18px 32px rgba(0,0,0,0.18);
        padding: 14px 12px;
        display: none;
      }

      .panel.open {
        display: block;
      }

      .panel h3 {
        margin: 0 0 10px;
        font-size: 0.9rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--dark-green);
      }

      .option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 6px;
        border-radius: 12px;
        transition: background 0.2s ease;
      }

      .option:hover {
        background: rgba(16, 47, 42, 0.05);
      }

      .option label {
        font-size: 0.88rem;
        font-weight: 700;
      }

      .switch {
        position: relative;
        width: 40px;
        height: 24px;
        display: inline-block;
      }

      .switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }

      .slider {
        position: absolute;
        inset: 0;
        background: #d7dadd;
        border-radius: 999px;
        transition: 0.2s ease;
      }

      .slider::before {
        content: "";
        position: absolute;
        width: 18px;
        height: 18px;
        left: 3px;
        top: 3px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        transition: 0.2s ease;
      }

      .switch input:checked + .slider {
        background: var(--green-deep);
      }

      .switch input:checked + .slider::before {
        transform: translateX(16px);
      }

      .hero {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        gap: 18px;
        min-height: 640px;
        padding-top: 24px;
      }

      .left {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-left: 10px;
      }

      .subtitle {
        margin: 22px 0 0;
        max-width: 560px;
        font-size: 1.18rem;
        line-height: 1.6;
        color: var(--text-soft);
      }

      .cta {
        margin-top: 30px;
        width: fit-content;
        min-width: 220px;
        border: none;
        border-radius: 999px;
        padding: 18px 36px;
        background: linear-gradient(135deg, var(--beige) 0%, var(--beige-strong) 100%);
        color: var(--dark-green);
        font-size: 1.08rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        cursor: pointer;
        box-shadow: 0 12px 28px rgba(228, 205, 170, 0.28);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(228, 205, 170, 0.34);
      }

      .right {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 520px;
      }

      .empty-card {
        width: min(395px, 88%);
        height: 385px;
        border-radius: 32px;
        background: #37664a;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: inset 0 0 18px rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 32px;
      }

      .card-content {
        width: 100%;
        text-align: center;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.4rem, 3vw, 3.3rem);
        line-height: 1.05;
        letter-spacing: -0.06em;
      }

      .emoji {
        display: inline-block;
        margin-left: 8px;
      }

      .inside-copy {
        margin-top: 18px;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--text-soft);
      }

      @media (max-width: 950px) {
        .page {
          padding: 24px 22px 30px;
        }

        .hero {
          grid-template-columns: 1fr;
          text-align: center;
          padding-top: 18px;
        }

        .left {
          padding-left: 0;
          align-items: center;
        }

        .subtitle {
          max-width: 620px;
        }

        .cta {
          width: 100%;
          max-width: 280px;
        }

        .right {
          order: -1;
          min-height: 360px;
        }

        .empty-card {
          width: min(350px, 80%);
          height: 230px;
        }
      }

      @media (max-width: 560px) {
        body {
          padding: 16px;
        }

        .page {
          min-height: auto;
          padding: 18px 16px 24px;
        }

        .brand {
          font-size: 1.4rem;
        }

        .dots-button {
          width: 44px;
          height: 44px;
        }

        h1 {
          font-size: 2.3rem;
        }

        .subtitle {
          font-size: 1rem;
        }

        .cta {
          min-width: 0;
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M12 21s-8.5-5.2-8.5-11.2C3.5 6.7 5.4 4.5 8.2 4.5c1.7 0 3 .9 3.8 2.2.8-1.3 2.1-2.2 3.8-2.2 2.8 0 4.7 2.2 4.7 5.3C20.5 15.8 12 21 12 21Z"/>
              <path d="M12 7.2c-.2-1.8-.1-3.1.8-4.4"/>
            </svg>
          </span>
          <span class="brand-name">Taste<span>Shift</span></span>
        </div>

        <div class="settings-wrap">
          <button class="dots-button" id="menuToggle" aria-label="Ustawienia">
            <span></span>
            <span></span>
            <span></span>
          </button>

          <div class="panel" id="settingsPanel">
            <h3>Tryb i styl</h3>

            <div class="option">
              <label for="sarcasm">Sarkastycznie</label>
              <label class="switch">
                <input type="checkbox" id="sarcasm" checked />
                <span class="slider"></span>
              </label>
            </div>

            <div class="option">
              <label for="kind">Uprzejmie</label>
              <label class="switch">
                <input type="checkbox" id="kind" checked />
                <span class="slider"></span>
              </label>
            </div>

            <div class="option">
              <label for="motivation">Konkretnie</label>
              <label class="switch">
                <input type="checkbox" id="motivation" checked />
                <span class="slider"></span>
              </label>
            </div>

            <div class="option">
              <label for="educational">Edukacyjnie</label>
              <label class="switch">
                <input type="checkbox" id="educational" />
                <span class="slider"></span>
              </label>
            </div>

            <div class="option">
              <label for="neutral">Neutralnie</label>
              <label class="switch">
                <input type="checkbox" id="neutral" />
                <span class="slider"></span>
              </label>
            </div>
          </div>
        </div>
      </header>

      <main class="hero">
        <section class="left">
          <p class="subtitle">
            Razem zadbamy o Twoje odżywianie! — bez presji, wyrzutów sumienia
            i „jutro zaczynam od nowa”. W Twoim tempie i na Twoich zasadach.
          </p>

          <button class="cta">Zaczynamy!</button>
        </section>

        <section class="right" aria-label="Witaj w TasteShift">
          <div class="empty-card">
            <div class="card-content">
              <h1>
                Witaj w TasteShift! <span class="emoji">😎</span>
              </h1>
              <div class="inside-copy">
                Razem zadbamy o Twoją żywność!
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      const toggle = document.getElementById("menuToggle");
      const panel = document.getElementById("settingsPanel");
      const neutral = document.getElementById("neutral");
      const otherOptions = panel.querySelectorAll(
        'input[type="checkbox"]:not(#neutral)'
      );

      neutral.addEventListener("change", function () {
        if (neutral.checked) {
          otherOptions.forEach(function (option) {
            option.checked = false;
          });
        }
      });

      otherOptions.forEach(function (option) {
        option.addEventListener("change", function () {
          if (option.checked) {
            neutral.checked = false;
          }
        });
      });

      toggle.addEventListener("click", function () {
        panel.classList.toggle("open");
      });

      document.addEventListener("click", function (event) {
        if (!event.target.closest(".settings-wrap")) {
          panel.classList.remove("open");
        }
      });
    </script>
  </body>
</html>
