<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TasteShift</title>
    <style>
      :root {
        --dark-green: #102f2a;
        --green-deep: #163f38;
        --green-soft: #234f4a;
        --beige: #f3e7d9;
        --beige-strong: #e5d3b5;
        --white: #ffffff;
        --text-soft: #dfeae6;
        --shadow: rgba(12, 28, 23, 0.22);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.08), transparent 28%),
          linear-gradient(135deg, var(--dark-green) 0%, var(--green-deep) 45%, var(--green-soft) 100%);
        color: var(--white);
        display: grid;
        place-items: center;
      }

      .wrapper {
        width: min(1200px, 90vw);
        min-height: 740px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 32px;
        box-shadow: 0 25px 60px var(--shadow);
        padding: 26px 30px 40px;
        backdrop-filter: blur(6px);
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
      }

      .brand {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: var(--beige);
      }

      .brand span {
        color: var(--white);
      }

      .settings {
        position: relative;
      }

      .dots-button {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255,255,255,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .dots-button:hover {
        transform: translateY(-1px);
        background: rgba(255,255,255,0.12);
      }

      .dots-button span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--beige);
        display: block;
      }

      .panel {
        position: absolute;
        top: 72px;
        right: 0;
        width: 270px;
        background: rgba(255,255,255,0.94);
        color: var(--dark-green);
        border-radius: 20px;
        box-shadow: 0 18px 28px rgba(0,0,0,0.18);
        padding: 18px 16px;
        display: none;
      }

      .panel.open {
        display: block;
      }

      .panel h3 {
        margin: 0 0 14px;
        font-size: 1rem;
        color: var(--dark-green);
        letter-spacing: 0.03em;
      }

      .option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 8px;
        border-radius: 12px;
        transition: background 0.2s ease;
      }

      .option:hover {
        background: rgba(16, 47, 42, 0.06);
      }

      .option label {
        font-size: 0.95rem;
        font-weight: 600;
      }

      .switch {
        position: relative;
        width: 46px;
        height: 28px;
        display: inline-block;
      }

      .switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }

      .slider {
        position: absolute;
        inset: 0;
        background: #d8dadd;
        border-radius: 999px;
        transition: 0.2s ease;
      }

      .slider::before {
        content: "";
        position: absolute;
        width: 20px;
        height: 20px;
        left: 4px;
        top: 4px;
        background: white;
        border-radius: 50%;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        transition: 0.2s ease;
      }

      .switch input:checked + .slider {
        background: var(--green-deep);
      }

      .switch input:checked + .slider::before {
        transform: translateX(18px);
      }

      .hero {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        gap: 24px;
        min-height: 640px;
        padding-top: 18px;
      }

      .eyebrow {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.13);
        color: var(--beige);
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 22px;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.8rem, 5vw, 5rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
        max-width: 700px;
      }

      .emoji {
        display: inline-block;
        transform: translateY(-6px);
      }

      .subtitle {
        margin-top: 22px;
        max-width: 560px;
        font-size: 1.2rem;
        line-height: 1.6;
        color: var(--text-soft);
      }

      .cta {
        margin-top: 28px;
        border: none;
        background: linear-gradient(135deg, var(--beige) 0%, #d6b189 100%);
        color: var(--dark-green);
        font-weight: 800;
        font-size: 1.08rem;
        padding: 18px 42px;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(232, 208, 176, 0.28);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(232, 208, 176, 0.35);
      }

      .visual {
        display: flex;
        justify-content: center;
        align-items: center;
      }

      .food-card {
        width: min(430px, 90%);
        border-radius: 30px;
        padding: 24px;
        background: linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0.04));
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 25px 50px rgba(0,0,0,0.18);
      }

      .plate {
        position: relative;
        height: 430px;
        background: radial-gradient(circle at 50% 40%, #fff9f0 0%, #f3e7d9 30%, #e4d0af 62%, #d1af8f 100%);
        border-radius: 50%;
        border: 18px solid rgba(255,255,255,0.4);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .leaf, .leaf::before, .leaf::after {
        position: absolute;
        background: linear-gradient(135deg, #8abf67, #b6d788);
        border-radius: 60% 0 60% 0;
        transform: rotate(26deg);
      }

      .leaf {
        width: 110px;
        height: 140px;
        right: 110px;
        top: 90px;
        box-shadow: inset 0 0 18px rgba(255,255,255,0.2);
      }

      .leaf::before {
        content: "";
        width: 90px;
        height: 118px;
        top: 20px;
        left: -50px;
        transform: rotate(-28deg);
      }

      .leaf::after {
        content: "";
        width: 80px;
        height: 104px;
        bottom: 6px;
        right: -30px;
        transform: rotate(46deg);
      }

      .fruit {
        position: absolute;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f6d4a4, #ef9d68);
        box-shadow: inset -16px -10px 30px rgba(125, 66, 28, 0.18);
      }

      .fruit.one {
        left: 78px;
        bottom: 78px;
      }

      .fruit.two {
        left: 170px;
        bottom: 130px;
        width: 102px;
        height: 102px;
        background: linear-gradient(135deg, #ed8a60, #d86945);
      }

      .fruit.three {
        right: 82px;
        bottom: 90px;
        width: 116px;
        height: 116px;
        background: linear-gradient(135deg, #f0cf7c, #d6a94d);
      }

      .small-card {
        margin-top: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 18px;
        padding: 12px 16px;
        color: var(--beige);
      }

      .small-card strong {
        display: block;
        color: var(--white);
        font-size: 1rem;
      }

      .small-card span {
        font-size: 0.85rem;
        color: var(--text-soft);
      }

      @media (max-width: 900px) {
        .wrapper {
          padding: 20px 20px 32px;
        }

        .hero {
          grid-template-columns: 1fr;
          text-align: center;
        }

        .subtitle {
          margin-left: auto;
          margin-right: auto;
        }

        .cta {
          width: 100%;
        }

        .visual {
          order: -1;
        }
      }

      @media (max-width: 520px) {
        .brand {
          font-size: 1.35rem;
        }

        .dots-button {
          width: 50px;
          height: 50px;
        }

        h1 {
          font-size: 2.5rem;
        }

        .subtitle {
          font-size: 1rem;
        }

        .food-card {
          width: 100%;
        }

        .plate {
          height: 330px;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <header class="topbar">
        <div class="brand">Taste<span>Shift</span></div>

        <div class="settings">
          <button class="dots-button" id="menuToggle" aria-label="Ustawienia">
            <span></span>
            <span></span>
            <span></span>
          </button>

          <div class="panel" id="settingsPanel">
            <h3>Tryb i styl</h3>

            <div class="option">
              <label for="sarcasm">Sarkazm</label>
              <label class="switch">
                <input type="checkbox" id="sarcasm" checked />
                <span class="slider"></span>
              </label>
            </div>

            <div class="option">
              <label for="kind">Bycie miłym</label>
              <label class="switch">
                <input type="checkbox" id="kind" checked />
                <span class="slider"></span>
              </label>
            </div>

            <div class="option">
              <label for="pressure">Ciśnienie na maksa</label>
              <label class="switch">
                <input type="checkbox" id="pressure" />
                <span class="slider"></span>
              </label>
            </div>

            <div class="option">
              <label for="motivation">Motywacja</label>
              <label class="switch">
                <input type="checkbox" id="motivation" checked />
                <span class="slider"></span>
              </label>
            </div>
          </div>
        </div>
      </header>

      <main class="hero">
        <section>
          <div class="eyebrow">zdrowe wybory, bez chaosu</div>
          <h1>
            Witaj w TasteShift!<br />
            Razem zadbamy o Twoją żywność! <span class="emoji">😄</span>
          </h1>

          <p class="subtitle">
            Lepiej jedz, lepiej się czujesz i łatwiej utrzymujesz nawyki —
            bez stresu, bez wyrzutów i bez „jutro zaczynam od nowa”.
          </p>

          <button class="cta">Zaczynamy!</button>
        </section>

        <section class="visual" aria-label="Ilustracja jedzenia">
          <div class="food-card">
            <div class="plate">
              <div class="leaf"></div>
              <div class="fruit one"></div>
              <div class="fruit two"></div>
              <div class="fruit three"></div>
            </div>

            <div class="small-card">
              <div>
                <strong>Twoje API zdrowego rytmu</strong>
                <span>smacznie, sensownie i bez przymusu</span>
              </div>
              <div>🥗</div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      const toggle = document.getElementById("menuToggle");
      const panel = document.getElementById("settingsPanel");

      toggle.addEventListener("click", () => {
        panel.classList.toggle("open");
      });

      document.addEventListener("click", (event) => {
        if (!event.target.closest(".settings")) {
          panel.classList.remove("open");
        }
      });
    </script>
  </body>
</html>
